<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title><%= title %></title>
	<link rel="stylesheet" href="/<%= [options.rootPath, "public", "css", "index.css"].map(functions.removeLeadingTrailingSlashes).join("/") %>">
</head>
<body>
	<nav id="breadcrumbs">
		<ul>
			<% const breadcrumbs = items[0].KeyParts.slice(-1); %>
			<% breadcrumbs.forEach(function (item, index, arr) { %>
			<li>
				<a href="<%= [options.rootPath, ...arr.slice(0, index)].map(functions.removeLeadingTrailingSlashes).join("/") %>"><%= item %></a>
			</li>
			<% }); %>
		</ul>
	</nav>
	<table>
		<thead>
			<tr>
				<th><%= title %></th>
			</tr>
		</thead>
		<tbody>
			<% for (const item of items) { %>
			<tr>
				<td>
					<a href="<%= item.URL %>" class="inlineBlock">
						<li><%= item.FileName %></li>
					</a>
				</td>
			</tr>
			<% } %>
		</tbody>
	</table>
	<footer><% if (options.footer !== "") { %>
		<p class="inlineBlock"><%= options.footer %></p><% } %>
		<p class="inlineBlock right">Generated using <a href="https://github.com/rrainn/s3-explorer-static-generator">s3-explorer-static-generator</a></p>
	</footer>
</body>
</html>
